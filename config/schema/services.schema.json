{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tunnelWithAC/multi-region-deployments/config/schema/services.schema.json",
  "title": "Multi-region service registry",
  "description": "Microservice repositories targeted by the region fan-out orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["services"],
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo", "workflow"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Logical service name for logs and documentation."
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository in owner/name form.",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "workflow": {
            "type": "string",
            "minLength": 1,
            "description": "Workflow file name under .github/workflows/ (e.g. deploy.yml)."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "default": "main",
            "description": "Git ref to dispatch the workflow against."
          }
        }
      }
    }
  }
}
